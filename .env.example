BOT_TOKEN=
API_ID=
API_HASH=

# ── Optional ──
# Displayed username used to build t.me/… links. Detected from Telegram at
# startup when left unset, so this is only for overriding it.
#BOT_USERNAME=

# Where the web server listens. The port is what most hosts expect you to read
# from $PORT; the Dockerfile sets PORT=8080 to match the default here.
#WEB_SERVER_BIND_ADDRESS=0.0.0.0
#PORT=8080

# Path to the JSON store used when no MongoDB URI is configured, and to the
# admin settings file. Both default to the working directory.
#LOCAL_DB_PATH=local_db.json
#SETTINGS_PATH=bot_settings.json

# Number of proxy hops in front of this server, counted from the RIGHT of
# X-Forwarded-For. Leave at 1 behind a single reverse proxy; raise it for a
# chain (Cloudflare in front of nginx = 2). This is what the /lock attempt
# limiter and the rate limiter bucket clients by, and values below 1 are
# clamped up to 1 — there is no way to disable the header entirely from here.
#TRUSTED_PROXY_COUNT=1

# Worker-thread count for Telegram file handling (default 4).
#TG_BOT_WORKERS=4

# Disable terminal colour in the startup banner.
#NO_COLOR=1

# ── Optional: subtitle / audio-track extraction (web/media.py) ──
# These only matter if the FFmpeg binaries are installed on the host (the
# Dockerfile does this via apt). Without FFmpeg the bot runs fine and simply
# offers no extracted tracks, so both can be left unset.
# Where extracted .vtt/.audio files are cached on disk.
#MEDIA_CACHE_DIR=media_cache
# Skip extraction for source files larger than this many GB, so a huge MKV
# can't fill a small container disk.
#MEDIA_TRACK_MAX_GB=4
